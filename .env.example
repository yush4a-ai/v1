# Единственный .env монорепо. Раньше их было два — свой в apps/twitch-bots и
# свой в apps/cigilbot — и в обоих лежали одни и те же PANEL_TWITCH_* ключи с
# РАЗНЫМИ значениями: двум панелям на разных портах нужны были разные
# redirect URI, значит и разные приложения Twitch. Панель одна (порт 8766),
# приложение Twitch одно, файл один.
#
#   copy .env.example .env
#
# Профили ботов (.env.<profile>) остались рядом с main.py в apps/twitch-bots —
# слияние свело к одному файлу общий конфиг, а не профильную модель.

# ============================================================ ЧАТ-БОТ =======

# Токен для чат-бота (TWITCH_BOT_TOKEN + TWITCH_BOT_REFRESH_TOKEN) — НЕ
# заполнять руками. Получается через панель: Settings -> кнопка «Получить
# чат-токен бота» (роль ADMIN+, вход под аккаунтом бота на Twitch) —
# panel/auth.py::/auth/bot/chat_login записывает оба значения сюда сама и
# настраивает автообновление. Старый способ (сторонний генератор токена,
# twitchtokengenerator.com) не выдавал refresh_token — токен истекал молча,
# чтение чата продолжало работать, а отправка сообщений (PRIVMSG) тихо
# переставала. Оставлять эти две строки пустыми до входа через панель.
TWITCH_BOT_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# Имя аккаунта бота (можно использовать свой основной аккаунт, если отдельный не нужен).
# Панель перезаписывает это значение реальным логином после /auth/bot/chat_login.
TWITCH_BOT_NICK=cigilbot

# Канал профиля "main". Один аккаунт бота обслуживает все каналы сразу —
# рабочий список main.py берёт из Channel Registry (registry.db), а это
# значение остаётся запасным вариантом на случай пустого реестра.
TWITCH_CHANNEL=твой_канал

# Ключ DeepSeek API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Как бот будет обращаться к себе в чате, чтобы люди могли его позвать
BOT_TRIGGER=бот

# Личность бота — как он должен себя вести и разговаривать
BOT_PERSONALITY=Ты — дерзкий, но добрый чат-бот стримера. Отвечай коротко (1-2 предложения), с юмором, используй сленг Twitch-чата. Никогда не пиши длинных сообщений.

# Как называть тебя (стримера) в памяти бота при голосовом общении
STREAMER_NAME=стример

# Свободное описание происходящего на стриме — подмешивается в промт, чтобы
# бот понимал контекст (во что играешь, что за ивент). Пусто — не подмешивается.
STREAMER_CONTEXT=

# Анти-спам модерация. Флаг решает одно: писать ли main.py каждое сообщение
# чата в очередь mod_inbox (таблица внутри bot.db), откуда её забирает
# cigilbot/consumer.py. Сама модерация настраивается в config/moderation.yml.
MODERATION_ENABLED=true

# ============================================================ ГОЛОС =========
# Требует отдельной установки: pip install -r requirements-voice.txt (~600 МБ).

# Включить голосовой ввод (true/false). При первом запуске скачает модель
# распознавания речи локально, дальше работает офлайн и бесплатно.
VOICE_ENABLED=false

# Откуда брать звук: mic — микрофон, twitch — звуковая дорожка самого стрима.
VOICE_SOURCE=mic

# Чей стрим слушать при VOICE_SOURCE=twitch. Пусто — берётся TWITCH_CHANNEL.
VOICE_STREAM_CHANNEL=

# Триггеры для голоса — отдельно от BOT_TRIGGER, потому что распознавание речи
# коверкает имя (пиши корни без окончаний, сравнение нестрогое).
# Пусто — берутся из BOT_TRIGGER.
VOICE_TRIGGER=

# true — на голос бот отвечает ТОЛЬКО когда услышал своё имя.
# false — без имени тоже иногда вставляет реплику, а по имени отвечает всегда.
VOICE_REQUIRE_TRIGGER=false

# Порог тишины для нарезки фраз (чем меньше, тем чувствительнее к тихой речи).
VOICE_SILENCE_THRESHOLD=500

# Минимум секунд между репликами без обращения по имени (VOICE_REQUIRE_TRIGGER=false).
VOICE_FREE_REPLY_COOLDOWN=20

# ============================================================ ПАНЕЛЬ ========
# http://localhost:8766 — оба экрана (Модерация и Боты) в одном процессе,
# вход один на оба.

# Отдельное Twitch-приложение (НЕ то же самое, что TWITCH_BOT_TOKEN) —
# зарегистрировать на https://dev.twitch.tv/console/apps, добавив ВСЕ эти
# OAuth Redirect URL (один на каждый под-flow — Twitch требует точного
# совпадения):
#   http://localhost:8766/auth/callback
#   http://localhost:8766/auth/bot/callback
#   http://localhost:8766/auth/clip/callback
#   Client Type: Confidential
# Роль определяется автоматически: сам канал — OWNER, модераторы канала —
# MODERATOR, остальные вошедшие — VIEWER. Роль ADMIN выдаётся вручную
# существующим OWNER/ADMIN на экране Panel Users (таблица mod_panel_users).
PANEL_TWITCH_CLIENT_ID=
PANEL_TWITCH_CLIENT_SECRET=

# Канал, чьих модераторов панель считает авторизованными.
PANEL_TWITCH_CHANNEL=твой_канал

# Секрет для подписи cookie-сессий панели (случайная строка, держать в
# тайне — компрометация даёт возможность подделать любую сессию/роль).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_SESSION_SECRET=

# true, если панель доступна ТОЛЬКО по HTTPS (прямая раздача или через
# прокси/туннель) — тогда браузер не отправит cookie-сессию по обычному
# HTTP, и она не утечёт пассивному снифферу в той же сети. По умолчанию
# false: панель по HTTP на localhost/LAN — включать true только когда
# HTTPS перед панелью реально настроен, иначе вход сломается.
PANEL_SESSION_HTTPS_ONLY=false

# Общий секрет для POST /api/registry/channels — серверного эндпоинта
# зеркалирования Channel Registry. Панель им больше не пользуется (процесс
# один, зеркало пишется напрямую), но эндпоинт остаётся рабочим входом для
# внешнего вызова и без этого ключа отвечает 503.
INTERNAL_SYNC_TOKEN=

# ============================================================ МОДЕРАЦИЯ =====

# Токен бота для реальных банов/таймаутов (cigilbot/executor.py).
# Заполняются АВТОМАТИЧЕСКИ кнопкой "Получить токен бота" на экране Settings
# (роль ADMIN+) — руками сюда обычно ничего вписывать не нужно.
# Проходящий вход должен быть залогинен на Twitch ПОД АККАУНТОМ БОТА (не под
# личным), иначе moderator_id токена не совпадёт с аккаунтом бота и все баны
# будут падать с 401. Аккаунт бота также должен быть модератором канала
# (команда /mod <бот> в чате).
TWITCH_MOD_ACCESS_TOKEN=
TWITCH_MOD_REFRESH_TOKEN=
TWITCH_MOD_BOT_LOGIN=
TWITCH_MOD_BOT_USER_ID=
TWITCH_MOD_BROADCASTER_ID=

# ============================================================ АВТОКЛИП ======

# Включает автоклип (bot/autoclip.py): три триггера — всплеск активности
# чата, ключевая фраза в чате, голосовая команда стримера — любой создаёт
# клип через Twitch Helix Clips API. По умолчанию выключен: включайте
# явно, когда пороги в config/channels/<канал>.yml подобраны под конкретный
# канал (см. config/channels/example.yml, секция autoclip:).
AUTOCLIP_ENABLED=false

# Токен для создания клипов (scope clips:edit) — ОТДЕЛЬНЫЙ от TWITCH_MOD_*
# выше: Twitch не позволяет добавить scope к уже выпущенному токену, у
# клипов свой scope, не связанный с банами/таймаутами.
# В .env НЕ хранится: токен клиппинга per-channel (Twitch принимает клип
# только от токена, принадлежащего вещателю/модератору/редактору именно
# того канала, для которого создаётся клип), поэтому живёт в
# mod.<broadcaster_id>.db, отдельно на каждый канал. Получается кнопкой
# "Получить токен для клиппинга" на экране Автоклип (роль ADMIN+, канал
# выбирается там же) — руками сюда вписывать нечего.

# ============================================================ СЛУЖЕБНОЕ =====
# Обычно не трогают.

# Суффикс к именам файлов инстанса: bot.<INSTANCE>.db, usage.<INSTANCE>.json,
# logs/bot.<INSTANCE>.log. Пусто — файлы без суффикса. Проставляется
# автоматически в .env.<profile> при создании профиля через панель.
INSTANCE=

# Какой .env читать боту. Именно так панель разводит профили: запускает
# main.py с BOT_ENV_FILE=<путь к .env.<profile>>. В корневом .env задавать
# не нужно.
# BOT_ENV_FILE=

# Путь к apps/twitch-bots — оттуда cigilbot/consumer.py читает bot.db
# (очередь mod_inbox). Пусто — вычисляется относительно самого Cigilbot.
BOT_PROJECT_ROOT=
