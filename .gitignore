# Единственный venv монорепо, в корне.
.venv/

# `pip install -e .` (см. pyproject.toml — editable install, чтобы
# src/bot, src/cigilbot, src/panel, src/paths были импортируемы) кладёт
# сюда метаданные пакета при сборке. Не код — генерируется заново.
*.egg-info/
build/
dist/

# Секреты. Правило-исключение покрывает и .env.example, и .env.<что-то>.example —
# без второй строки любой пример с суффиксом остался бы невидимым для git.
.env
.env.*
!.env.example
!.env.*.example

# Всё рабочее состояние — в var/, одной строкой. Живые БД, pid/lock-файлы,
# логи, счётчики расхода API, очередь голоса, история каналов и промтов.
# БД не версионируются намеренно — это рабочие данные каналов, не код.
#
# Раньше здесь был список масок (*.db, *.pid, *.lock, logs/, usage*.json,
# voice_input*.txt, **/panel/channel_history.json), потому что состояние
# лежало вперемешку с исходниками в корнях проектов. Каждый новый вид
# рабочего файла требовал новой строки, а промах означал секрет или живую
# БД в коммите.
var/

# Маски на случай состояния, созданного СТАРОЙ версией кода (до переезда в
# var/) — чтобы обновившийся клон не закоммитил забытые файлы из корня.
*.db
*.db-shm
*.db-wal
*.pid
*.lock
logs/
voice_input*.txt
usage*.json

# Архив остатков старой per-channel модели — держим на диске как данные для
# калибровки порогов, но под git им делать нечего.
_archive/

# Кеши инструментов и сгенерированное
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
graphify-out/

# Локальные настройки редактора/агента
.claude/settings.local.json
